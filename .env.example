# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_DRIVE_FOLDER_ID: ID or URL of the shared/public Google Drive folder containing legislation, NBRs, and construction laws.
# Example: 1aBcDeFgHijKlmNoPqrStuVwxYz or https://drive.google.com/drive/folders/1aBcDeFgHijKlmNoPqrStuVwxYz
GOOGLE_DRIVE_FOLDER_ID=""

# ALLOWED_EMAILS: Lista VIP de e-mails autorizados separados por vírgula (whitelist).
# Se definida, apenas usuários logados com esses e-mails podem acessar as consultas.
# Exemplo: engenheiro@empresa.com,diretoria@construtora.com.br,fabianosm2311@gmail.com
ALLOWED_EMAILS=""

# GOOGLE_CLIENT_ID: Client ID do Google OAuth2 para login no frontend via Google Identity Services
# Exemplo: 1234567890-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
